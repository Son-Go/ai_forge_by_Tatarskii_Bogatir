# PostgreSQL и локальный адрес стенда
POSTGRES_PASSWORD=replace-for-local-dev
SITE_ADDRESS=:80
EDGE_BIND=127.0.0.1
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443
# Grafana доступна через loopback, удалённо — через SSH-туннель.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-for-local-dev
# Для дополнительных адресов укажите точные origin через запятую.
CHAT_PUBLIC_ORIGIN=http://localhost:8080

# Каталог и база знаний. Пути к файлам задаются внутри контейнера backend.
CATALOG_FEED_URL=
CATALOG_FEED_FILE=
CATALOG_KNOWLEDGE_FILE=
CATALOG_SYNC_CRON="0 0 4 * * *"
CATALOG_SYNC_ZONE=Europe/Moscow

# Чат и кабинет менеджера
CHAT_TURN_TIMEOUT_MS=90000
CHAT_COLD_TURN_TIMEOUT_MS=120000
CHAT_MODEL_IDLE_MS=15000
CHAT_PARALLEL_TURNS=8
CHAT_QUOTES_ENABLED=false
CHAT_INVOICE_DRAFTS_ENABLED=false
# Формат списка: manager-demo=token,second-manager=token.
MANAGER_ACCESS_TOKENS=

# Подключение модели из Spring Boot
# Адрес в сети Compose: http://ml-service:8000.
# ML_DATA_REGION=RU указывает на подтверждённое размещение контура в РФ.
ML_BASE_URL=
ML_DATA_REGION=
# Собственный Bearer-токен, общий для Spring Boot и FastAPI.
ML_SERVICE_TOKEN=
ML_MAX_CONTEXT_BYTES=24000

# Профиль RunPod для экспериментов на публичных и синтетических данных
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL=Qwen/Qwen3-32B-AWQ
RUNPOD_MODEL_VERSION=qwen3-32b-awq-base
RUNPOD_MAX_CONCURRENCY=1
RUNPOD_RESPONSE_FORMAT=prompt
